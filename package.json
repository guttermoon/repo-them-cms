{
  "name": "repo-them",
  "description": "REPO THEM: a Notion-powered CMS. A website you write in Notion: copy, pages, a blog, a shop and plans in one Notion database, on Next.js.",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "notion",
    "notion-cms",
    "cms",
    "website-template",
    "nextjs",
    "react",
    "vercel",
    "blog",
    "shop",
    "shopify",
    "printify",
    "accessibility",
    "privacy",
    "typescript"
  ],
  "homepage": "https://github.com/guttermoon/repo-them-cms#readme",
  "bugs": {
    "url": "https://github.com/guttermoon/repo-them-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guttermoon/repo-them-cms.git"
  },
  "license": "MIT",
  "author": {
    "name": "Megan Aileen Williams",
    "url": "https://denot.app"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/snapshot.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/email-setup.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/posthog-setup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs --test tests/*.test.mjs && vitest run",
    "test:dom": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/snapshot.mjs",
    "copy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/dump-copy.mjs",
    "notion:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/notion-setup.mjs",
    "notion:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/notion-check.mjs",
    "notion:seed-copy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/notion-seed-copy.mjs",
    "notion:fake": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/fake-notion.mjs",
    "shop:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/shop-import.mjs",
    "posthog:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/posthog-setup.mjs --strict",
    "email:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/email-setup.mjs",
    "icons": "node scripts/build-icons.mjs",
    "qr": "node scripts/make-qr.mjs",
    "a11y": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/a11y-audit.mjs",
    "responsive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/responsive-audit.mjs",
    "privacy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/privacy-audit.mjs",
    "sharpness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/sharpness-audit.mjs",
    "indexnow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/indexnow.mjs",
    "demo-images": "node scripts/build-demo-images.mjs",
    "docs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/build-docs.mjs",
    "readme-images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register-ts.mjs scripts/readme-images.mjs"
  },
  "dependencies": {
    "@notionhq/client": "5.31.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@radix-ui/react-dialog": "1.3.1",
    "katex": "0.19.1",
    "next": "15.5.29",
    "posthog-js": "^1.448.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.5",
    "shiki": "4.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/env": "15.5.29",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^25.0.1",
    "postcss": "^8.5",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@posthog/browser-common": "0.9.5",
    "@posthog/core": "1.59.1",
    "@posthog/types": "1.416.0"
  }
}
