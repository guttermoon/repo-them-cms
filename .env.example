# REPO THEM: every setting the site reads. Copy this file to .env.local for
# your computer, and put the same names in your host's environment variables
# (Vercel: Project → Settings → Environment Variables) for the live site.
#
# Placeholders only: never commit a real value. .env.local is git-ignored.
# The site runs with none of these set: it shows the starter content, kept
# out of search, until a Notion database is connected.
# Each setting is explained at length in docs/.

# ── Notion (docs/notion.md) ────────────────────────────────────────────────

# The integration's token (Notion → Settings → Connections → Develop or
# manage integrations). The site needs Read content only.
NOTION_TOKEN=
# The database the site reads: its ID, or its whole address copied from
# Notion. Share it with the integration (the database's ⋯ menu → Connections).
NOTION_DATABASE_ID=
# Signs the /media/ addresses of pictures and files. Optional: unset, a key
# is derived from NOTION_TOKEN. Set one to keep addresses when the token
# changes. Any long random string.
# MEDIA_SIGNING_KEY=your_long_random_string

# ── Instant updates (docs/notion.md) ───────────────────────────────────────

# For /api/revalidate (a Notion database automation's webhook, or anything
# else that knows it). Unset, the route refuses everything.
REVALIDATION_SECRET=
# For /api/notion-webhook (a Notion integration webhook). Notion shows the
# verification token once, when the subscription is made; the route logs it
# the first time it arrives so you can paste it here.
# NOTION_WEBHOOK_SECRET=your_verification_token

# ── The site's address (docs/seo.md) ───────────────────────────────────────

# The domain the site is served on, for canonical addresses, the sitemap,
# the feed and the structured data. On Vercel it falls back to the project's
# production domain; set it once you have your own. Left as a comment so a
# copy of this file does not point every canonical address at a placeholder.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Where /.well-known/security.txt sends a security report: an email address
# or an https address. Unset, it names NEXT_PUBLIC_CONTACT_EMAIL (when set)
# and the contact form. Your own, never the template's maker's.
# SECURITY_CONTACT=security@your-domain.example

# ── Email: the mailing list and the contact form (docs/email.md) ───────────

# The platform: brevo, resend, sendgrid, mailchimp, klaviyo, beehiiv, loops,
# mailerlite, kit, buttondown, postmark or webhook. Unset, Brevo is used when BREVO_API_KEY is.
# EMAIL_PROVIDER=brevo
# A different platform for the contact form, for a list platform that sends
# no email of its own (Mailchimp, Klaviyo, beehiiv, Loops, MailerLite, Kit,
# Buttondown).
# CONTACT_EMAIL_PROVIDER=postmark
# Where contact-form messages go, and the sender they come from (an address
# the platform has verified).
CONTACT_TO_EMAIL=
EMAIL_FROM=
# A public address to print on /contact beside the form. Optional.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example

# Brevo
BREVO_API_KEY=
# The list: found or made by name ("<site name> newsletter"), or pinned by ID.
# BREVO_LIST_NAME=your_list_name
# BREVO_LIST_ID=your_list_id
# Double opt-in: both, or neither (a template of type double opt-in, and the
# page readers land on after confirming, normally /subscribed).
# BREVO_DOI_TEMPLATE_ID=your_template_id
# BREVO_DOI_REDIRECT_URL=https://your-domain.example/subscribed

# Mailchimp (list only)
# MAILCHIMP_API_KEY=your_key-us21
# MAILCHIMP_AUDIENCE_ID=your_audience_id
# MAILCHIMP_DOUBLE_OPT_IN=false

# MailerLite (list only)
# MAILERLITE_API_KEY=your_key
# MAILERLITE_GROUP_ID=your_group_id

# Klaviyo (list only): a private key that may write lists, profiles and
# subscriptions. Set the last to false when the list is single opt-in.
# KLAVIYO_API_KEY=your_private_key
# KLAVIYO_LIST_ID=your_list_id
# KLAVIYO_DOUBLE_OPT_IN=false

# beehiiv (list only)
# BEEHIIV_API_KEY=your_key
# BEEHIIV_PUBLICATION_ID=pub_your_publication_id
# BEEHIIV_WELCOME_EMAIL=false
# BEEHIIV_DOUBLE_OPT_IN=false

# Loops (list only)
# LOOPS_API_KEY=your_key
# LOOPS_MAILING_LIST_ID=your_mailing_list_id

# Kit, formerly ConvertKit (list only)
# KIT_API_KEY=your_key
# KIT_FORM_ID=your_form_id

# Buttondown (list only)
# BUTTONDOWN_API_KEY=your_key

# Resend (list and contact form)
# RESEND_API_KEY=your_key
# RESEND_SEGMENT_ID=your_segment_id

# Postmark (contact form only)
# POSTMARK_SERVER_TOKEN=your_server_token
# POSTMARK_MESSAGE_STREAM=outbound

# SendGrid (list and contact form)
# SENDGRID_API_KEY=your_key
# SENDGRID_LIST_ID=your_list_id

# A webhook (Zapier, Make, n8n or your own code): each sign-up and message
# is posted as JSON, signed with the secret when there is one.
# EMAIL_WEBHOOK_URL=https://your-endpoint.example/hook
# EMAIL_WEBHOOK_SECRET=your_long_random_string

# ── The shop (docs/commerce.md) ────────────────────────────────────────────

# Unset: the shop is an example (nothing for sale, not indexed). "shopify"
# checks the cart out at your Shopify shop; "printify" sends each product's
# button to its page in your Printify Pop-Up Store. Either way the shop
# keeps the catalogue, and npm run shop:import copies it into Notion.
# COMMERCE_PROVIDER=shopify
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# npm run shop:import only (never needed by the site itself):
# a Storefront API access token, from Shopify's Headless sales channel
# SHOPIFY_STOREFRONT_TOKEN=your_storefront_token
# SHOPIFY_API_VERSION=2026-10
# a Printify personal access token, the shop's number, and its currency
# PRINTIFY_API_TOKEN=your_printify_token
# PRINTIFY_SHOP_ID=your_shop_number
# PRINTIFY_CURRENCY=USD
# a Notion integration of its own that may read, insert and update content,
# so the site's token stays read-only
# NOTION_IMPORT_TOKEN=your_import_integration_token

# ── Analytics: off until a reader says yes (docs/analytics.md) ─────────────

# PostHog: the project's key (phc_…), and its cloud ("eu" unless "us").
# NEXT_PUBLIC_POSTHOG_KEY=your_project_key
# NEXT_PUBLIC_POSTHOG_REGION=eu
# PostHog's feedback loop (docs/feedback.md): a personal API key (phx_…)
# with read on projects and organizations and write on surveys and feature
# flags. With it, every build makes the "Site feedback" survey and the
# code's flags in the project when they are missing; without it, make them
# by hand or run npm run posthog:setup. The project's id, only when the key
# reaches more than one organisation.
# POSTHOG_PERSONAL_API_KEY=your_personal_api_key
# POSTHOG_PROJECT_ID=your_project_id
# The loop's agent reads these as GitHub repository secrets, not from here
# (.github/workflows/feedback-loop.yml): one of the two, with the personal
# key above.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_CODE_OAUTH_TOKEN=your_claude_code_oauth_token
# Optional: a fine-grained token that may open its pull requests, for a
# repository that does not let Actions open them (docs/feedback.md).
# FEEDBACK_GH_TOKEN=your_github_token
# PostHog Logs: a line from the server when a message is delivered or a
# sign-up accepted, never who. Your region's address, e.g.
# https://eu.i.posthog.com/i/v1/logs (or us.i.posthog.com). Off when empty.
# POSTHOG_LOGS_ENDPOINT=
# Google Analytics 4: the measurement ID (G-…).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=your_measurement_id

# ── Search (docs/seo.md) ───────────────────────────────────────────────────

# Search Console and Bing Webmaster Tools' HTML-tag verification: the token
# alone, not the whole <meta> tag.
# GOOGLE_SITE_VERIFICATION=your_google_token
# BING_SITE_VERIFICATION=your_bing_token
# IndexNow: any 8 to 128 letters, digits and dashes; served at /indexnow.txt.
# INDEXNOW_KEY=your_indexnow_key
# The live site, for `npm run indexnow` and its GitHub workflow.
# SITE_URL=https://your-domain.example

# ── Rate limits across instances (docs/privacy-and-security.md) ───────────

# A Redis that speaks Upstash's REST API, so every instance shares one count
# per caller. Optional: unset, each instance counts alone. On Vercel, add
# Upstash from the Marketplace (Storage) and it sets the KV_ pair itself.
# Only a keyed hash of a caller's address is ever stored, keyed with
# MEDIA_SIGNING_KEY or NOTION_TOKEN: a site with neither counts in memory.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your_kv_token

# ── Testing only: never set these on a live site (docs/development.md) ────

# A stand-in Notion (npm run notion:fake) and stand-ins for the other APIs.
# NOTION_API_BASE_URL=http://127.0.0.1:4010
# BREVO_API_URL=http://127.0.0.1:4020
# POSTHOG_PROXY_UPSTREAM=http://127.0.0.1:4030
# GA_PROXY_UPSTREAM=http://127.0.0.1:4040
# Where the audits find Chromium, when it is not where Playwright put it.
# PLAYWRIGHT_CHROMIUM=/path/to/chromium
